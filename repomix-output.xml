  name: string;
  ext: string;
}

interface CharacterCardV3 {
  spec: string;
  spec_version: string;
  data: {
    name: string;
    nickname?: string;
    description: string;
    personality: string;
    mes_example: string;
    scenario: string;
    first_mes: string;
    alternate_greetings: string[];
    tags: string[];
